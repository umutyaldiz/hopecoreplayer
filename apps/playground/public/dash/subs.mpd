			<Representation id="0" mimeType="video/mp4" codecs="avc1.4d401e" bandwidth="500000" width="640" height="360" sar="1:1">
				<SegmentTemplate timescale="1000000" duration="2000000" initialization="clear-init-$RepresentationID$.m4s" media="clear-$RepresentationID$-$Number$.m4s" startNumber="1">
				</SegmentTemplate>
			</Representation>
