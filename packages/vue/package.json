{
  "name": "@hopeplayer/vue",
  "version": "1.7.0",
  "description": "Thin Vue 3 wrapper around <hope-player> (@hopeplayer/core) — prop/event bridge only, no state duplication",
  "keywords": ["vue", "vue3", "nuxt", "vue-component", "video-player", "video", "player", "html5-video", "hls", "m3u8", "web-component", "custom-element", "ima", "vast", "vmap", "prebid", "ads", "monetization", "chromecast", "airplay", "subtitles", "shadow-dom", "hopeplayer"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutyaldiz/hopecoreplayer.git",
    "directory": "packages/vue"
  },
  "homepage": "https://umutyaldiz.com/hopecoreplayer",
  "bugs": {
    "url": "https://github.com/umutyaldiz/hopecoreplayer/issues"
  },
  "author": "Umut Yaldız (https://www.umutyaldiz.com)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/hope-player-vue.js",
  "module": "./dist/hope-player-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hope-player-vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@hopeplayer/core": "^1.7.0",
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@hopeplayer/core": "^1.7.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "license": "MIT"
}
