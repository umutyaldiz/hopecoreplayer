{
  "name": "@hopeplayer/react",
  "version": "1.0.7",
  "description": "Thin React wrapper around <hope-player> (@hopeplayer/core) — prop/event bridge only, no state duplication",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutyaldiz/hopecoreplayer.git",
    "directory": "packages/react"
  },
  "homepage": "https://umutyaldiz.com/hopecoreplayer",
  "bugs": {
    "url": "https://github.com/umutyaldiz/hopecoreplayer/issues"
  },
  "author": "Umut Yaldız (https://www.umutyaldiz.com)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/hope-player-react.js",
  "module": "./dist/hope-player-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hope-player-react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@hopeplayer/core": "^1.0.7",
    "react": ">=18"
  },
  "devDependencies": {
    "@hopeplayer/core": "^1.0.7",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
