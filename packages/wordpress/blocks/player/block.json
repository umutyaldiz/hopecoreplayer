{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hopecoreplayer/player",
	"version": "1.15.0",
	"title": "HopeCorePlayer",
	"category": "media",
	"icon": "video-alt3",
	"description": "Video or audio player with HLS / DASH, subtitles, chapters, playlist, sticky mini player and ads.",
	"keywords": [ "video", "audio", "player", "hls", "ads" ],
	"textdomain": "hopecoreplayer",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"attributes": {
		"mediaId": { "type": "number" },
		"src": { "type": "string", "default": "" },
		"format": { "type": "string", "default": "auto", "enum": [ "auto", "mp4", "hls", "dash" ] },
		"sources": { "type": "array", "default": [] },
		"poster": { "type": "string", "default": "" },
		"posterId": { "type": "number" },
		"audio": { "type": "boolean", "default": false },
		"title": { "type": "string", "default": "" },
		"artist": { "type": "string", "default": "" },
		"autoplay": { "type": "boolean", "default": false },
		"muted": { "type": "boolean", "default": false },
		"loop": { "type": "boolean", "default": false },
		"theme": { "type": "string", "default": "" },
		"accent": { "type": "string", "default": "" },
		"aspectRatio": { "type": "string", "default": "" },
		"subtitles": { "type": "array", "default": [] },
		"chapters": { "type": "array", "default": [] },
		"playlist": { "type": "array", "default": [] },
		"sticky": { "type": "string", "default": "default", "enum": [ "default", "on", "off" ] },
		"ads": { "type": "string", "default": "default", "enum": [ "default", "off", "custom" ] },
		"adPreroll": { "type": "string", "default": "" },
		"adVmap": { "type": "string", "default": "" },
		"advanced": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
