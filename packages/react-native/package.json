{
  "name": "@hopeplayer/react-native",
  "version": "1.0.12",
  "description": "React Native wrapper for HopeCorePlayer — runs <hope-player> in a WebView with a prop/event bridge (same options and callbacks as @hopeplayer/react)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutyaldiz/hopecoreplayer.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://umutyaldiz.com/hopecoreplayer",
  "bugs": {
    "url": "https://github.com/umutyaldiz/hopecoreplayer/issues"
  },
  "author": "Umut Yaldız (https://www.umutyaldiz.com)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/hope-player-react-native.js",
  "module": "./dist/hope-player-react-native.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hope-player-react-native.js",
      "default": "./dist/hope-player-react-native.js"
    },
    "./player-html": {
      "types": "./dist/playerHtml.d.ts",
      "import": "./dist/player-html.js",
      "default": "./dist/player-html.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react-native",
    "video",
    "player",
    "hls",
    "webview",
    "hopeplayer"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/bridge.e2e.mjs"
  },
  "dependencies": {
    "@hopeplayer/core": "^1.0.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
